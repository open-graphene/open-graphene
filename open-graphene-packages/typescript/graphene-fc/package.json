{
  "name": "@open-graphene/fc",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./signing": {
      "types": "./dist/signing.d.ts",
      "import": "./dist/signing.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memo": {
      "types": "./dist/memo.d.ts",
      "import": "./dist/memo.js"
    },
    "./wallet": {
      "types": "./dist/wallet.d.ts",
      "import": "./dist/wallet.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./dist/hash.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@open-graphene/primitives": "workspace:*",
    "@scure/base": "2.4.0"
  }
}
