{
  "name": "@open-graphene/transport",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@open-graphene/codec": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
