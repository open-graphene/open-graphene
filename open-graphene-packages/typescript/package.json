{
  "name": "open-graphene-typescript-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm build && tsc -p tests/tsconfig.json && node --test tests/*.test.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "test:browser": "node scripts/browser-test.mjs",
    "test:testnet": "pnpm build && node scripts/testnet-smoke.mjs",
    "test:testnet:browser": "pnpm build && node scripts/testnet-smoke.mjs --browser",
    "test:live:all": "pnpm build && node scripts/test-all-live.mjs",
    "test:bitshares:live": "pnpm build && node scripts/test-bitshares-live.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
