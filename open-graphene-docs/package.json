{
  "name": "@open-graphene/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm reference:generate && pnpm reference:check && next build --webpack && pnpm export:check",
    "dev": "pnpm reference:generate && next dev --webpack --port 3013",
    "types:check": "next typegen && tsc --noEmit",
    "format:check": "prettier --check .",
    "reference:generate": "node scripts/generate-reference.mjs",
    "reference:check": "node scripts/check-reference.mjs",
    "export:check": "node scripts/check-export.mjs"
  },
  "dependencies": {
    "@vanilla-extract/css": "1.21.3",
    "cn": "^0.4.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/next-plugin": "2.5.2",
    "postcss": "^8.5.28",
    "prettier": "3.9.5",
    "tailwindcss": "^4.3.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.15.0"
}
